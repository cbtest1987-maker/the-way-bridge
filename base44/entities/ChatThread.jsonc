{
  "name": "ChatThread",
  "type": "object",
  "properties": {
    "care_task_id": {
      "type": "string"
    },
    "journey_id": {
      "type": "string"
    },
    "requester_id": {
      "type": "string"
    },
    "volunteer_id": {
      "type": "string"
    },
    "last_message_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "closed"
      ],
      "default": "active"
    }
  },
  "required": [
    "journey_id"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.requester_id": "{{user.id}}"
        },
        {
          "data.volunteer_id": "{{user.id}}"
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.requester_id": "{{user.id}}"
        },
        {
          "data.volunteer_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.requester_id": "{{user.id}}"
        },
        {
          "data.volunteer_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
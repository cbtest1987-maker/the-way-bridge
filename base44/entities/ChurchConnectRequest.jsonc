{
  "name": "ChurchConnectRequest",
  "type": "object",
  "properties": {
    "journey_id": {
      "type": "string",
      "description": "Parent PrayerJourney"
    },
    "requesting_church_id": {
      "type": "string",
      "description": "Church that initiated the connection request"
    },
    "responding_church_id": {
      "type": "string",
      "description": "Church being asked to help (optional for purchase-pending requests)"
    },
    "need_type": {
      "type": "string",
      "enum": [
        "space",
        "building",
        "church_planting",
        "fundraising",
        "disaster",
        "resources",
        "ministry_resource"
      ]
    },
    "resource_name": {
      "type": "string",
      "description": "The specific ministry resource requested (e.g. Communion Tray)"
    },
    "details": {
      "type": "string",
      "description": "What the requesting church needs"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "responded",
        "accepted",
        "declined",
        "closed",
        "purchase_pending"
      ],
      "default": "open"
    },
    "response_message": {
      "type": "string",
      "description": "Message from responding church"
    },
    "responded_by_id": {
      "type": "string"
    },
    "purchase_options_requested": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "journey_id",
    "requesting_church_id",
    "need_type"
  ]
}
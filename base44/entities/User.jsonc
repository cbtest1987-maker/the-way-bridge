{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "user"
      ],
      "default": "user",
      "description": "Platform role. admin = Platform Administrator."
    },
    "app_role": {
      "type": "string",
      "enum": [
        "requester",
        "prayer_warrior",
        "care_volunteer",
        "church_admin",
        "church_connect_coordinator"
      ],
      "default": "requester",
      "description": "Primary role within theWay Bridge AI."
    },
    "church_id": {
      "type": "string",
      "description": "Church this user is affiliated with."
    },
    "service_roles": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "prayer_warrior",
          "care_volunteer",
          "church_connect_coordinator"
        ]
      },
      "description": "Church service roles a user holds (can be multiple)."
    },
    "church_approved": {
      "type": "boolean",
      "default": false,
      "description": "Church admin approval for service roles."
    },
    "background_check_status": {
      "type": "string",
      "enum": [
        "none",
        "pending",
        "cleared",
        "failed"
      ],
      "default": "none"
    },
    "volunteer_capabilities": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "e.g. transportation, food, resources"
    },
    "is_default_prayer_warrior": {
      "type": "boolean",
      "default": false,
      "description": "Designated default prayer warrior for timeout reassignment."
    },
    "care_safety_reviewer": {
      "type": "boolean",
      "default": false,
      "description": "Privileged permission assigned by Church Admin for care & safety review."
    },
    "volunteer_status": {
      "type": "string",
      "enum": [
        "none",
        "pending",
        "approved"
      ],
      "default": "none",
      "description": "Legacy approval status."
    }
  }
}
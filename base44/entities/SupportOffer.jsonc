{
  "name": "SupportOffer",
  "type": "object",
  "properties": {
    "need_id": {
      "type": "string"
    },
    "request_id": {
      "type": "string"
    },
    "volunteer_message": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "offered",
        "requester_review",
        "approved",
        "declined"
      ],
      "default": "offered"
    }
  },
  "required": [
    "need_id",
    "request_id"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}